# ProtocolPulse — Stage 2 configuration contract
# Contract PP-S2-CF-20261114-01 / 1.0.0-rc2 (APPROVED documentation freeze)
# Approval basis and decisions: PROJECT_CONTEXT.md; runtime validation is pending.
# Copy to repository-root .env for the FastAPI process. Never commit .env.
# The only value allowed in frontend/.env.local is NEXT_PUBLIC_API_BASE_URL.
# Values here are nonsecret local defaults or EMPTY placeholders — no real credentials.

# SQLite (root-relative path, run backend commands from repository root)
DATABASE_URL=sqlite:///./backend/var/protocolpulse.db
PROTOCOL_STORAGE_DIR=./backend/var/protocols

# Backend service / allowed CORS origin
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
API_LOG_LEVEL=INFO

# PUBLIC browser-side value ONLY; do not put secrets under NEXT_PUBLIC_*
# Place ONLY this one variable in frontend/.env.local, or pass as CLI env variable.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Selected provider/model: Gemini 3.8 Flash. OFF mode remains investigations UNAVAILABLE.
# Keep disabled until a server-side key and provider integration are configured/tested.
# The SDK receives LLM_API_KEY explicitly; do not require a second key variable.
LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
MAX_AGENT_STEPS=8
TOOL_TIMEOUT_SECONDS=5
LLM_CALL_TIMEOUT_SECONDS=10
AGENT_TIMEOUT_SECONDS=30

# Non-production synthetic-only data and reproducible seed
SYNTHETIC_DATA_ONLY=true
SEED=10415
DEMO_SEED_VERSION=px104-15-v1
DEFAULT_SITE_TIMEZONE=Europe/Athens
ENGINE_VERSION=px104-eval-v1
MAX_PDF_MB=12

# One SQLite-backed durable in-process worker. Do not run Uvicorn with >1 worker.
JOB_POLL_INTERVAL_MS=500
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECONDS=2
JOB_BATCH_SIZE=1

# Safety: no EHR tokens, live patient-system connection strings, or model API keys
# in Git, browser bundles, test fixtures, logs or recorded demo materials.
