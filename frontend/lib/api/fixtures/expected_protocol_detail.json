      "type": "MONITORING",
      "clinical_subject": "medication",
      "operator": "EVENT_RESTRICTED_USE",
      "threshold": "SYN-CLASS-R",
      "unit": null,
      "window": {
        "anchor": "PARTICIPATION",
        "start_offset_days": null,
        "end_offset_days": null,
        "start_inclusive": true,
        "end_inclusive": false,
        "time_zone": "Europe/Athens",
        "anchor_granularity": "INSTANT"
      },
      "evidence_requirement": "Confirmed dated administration or reliable documented use during participation.",
      "logical_group_id": "PX104-MONITORING-INDEPENDENT",
      "protocol_version_id": "PV-PX104-1.0",
      "missing_data_policy": "UNKNOWN_UNLESS_RECONCILED",
      "source_quote": "During human-recorded participation, a new confirmed administration or documented use of\nSYN-CLASS-R requires investigator review. Reliable dated administration or reported-use evidence\ntriggers a CONFIRMED_PROTOCOL_CONFLICT finding linked to a review case. Evaluate\nclinical-effective time; preserve the earlier screening assessment. This is a rule conflict, not a determination\nof harm. It authorizes no automatic treatment change or withdrawal.\n",
      "source_id": "SRC-PROTOCOL-PX104-V1",
      "source_page": 4,
