    {
      "criterion_id": "PX-EXC-02",
      "type": "EXCLUSION",
      "clinical_subject": "medication",
      "operator": "NO_RESTRICTED_USE",
      "threshold": "SYN-CLASS-R",
      "unit": null,
      "window": {
        "anchor": "SCREENING_DATE",
        "start_offset_days": -30,
        "end_offset_days": 0,
        "start_inclusive": true,
        "end_inclusive": false,
        "time_zone": "Europe/Athens",
        "anchor_granularity": "LOCAL_DATE"
      },
      "evidence_requirement": "Dated verified administration/reliable reported use, or reviewed no-use reconciliation covering the full window.",
      "logical_group_id": "PX104-ELIGIBILITY-ALL",
      "protocol_version_id": "PV-PX104-1.0",
      "missing_data_policy": "UNKNOWN_UNLESS_RECONCILED",
      "source_quote": "The patient must have no documented administration or reported use of SYN-CLASS-R during the 30\npreceding calendar days: [2026-10-01 00:00, 2026-10-31 00:00) in Europe/Athens. The start is included;\nthe end is excluded. Verified use overlapping this window fails. Passing requires explicitly reviewed no-use\nreconciliation covering the entire window. An order or dispense alone, missing dates, contradictory sources\nor an uncertain endpoint that could change overlap yields UNKNOWN. Do not infer stop dates or equate\nprescription or supply with ingestion.\n",
      "source_id": "SRC-PROTOCOL-PX104-V1",
      "source_page": 3,
      "source_anchor": {
