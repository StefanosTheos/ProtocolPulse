    },
    {
      "criterion_id": "PX-EXC-01",
      "type": "EXCLUSION",
      "clinical_subject": "condition",
      "operator": "ABSENCE_CONFIRMED_ACTIVE",
      "threshold": "SYN-EXCLUDED-CONDITION",
      "unit": null,
      "window": {
        "anchor": "SCREENING_DATE",
        "start_offset_days": 0,
        "end_offset_days": 0,
        "start_inclusive": true,
        "end_inclusive": true,
        "time_zone": "Europe/Athens",
        "anchor_granularity": "LOCAL_DATE"
      },
      "evidence_requirement": "Verified active condition or reviewed record-completeness declaration for its absence.",
      "logical_group_id": "PX104-ELIGIBILITY-ALL",
      "protocol_version_id": "PV-PX104-1.0",
      "missing_data_policy": "UNKNOWN_UNLESS_RECONCILED",
      "source_quote": "The patient must have no confirmed active SYN-EXCLUDED-CONDITION at screening. A verified active\ncondition fails this criterion. Passing requires a reviewed record-completeness declaration supporting\nabsence at screening. No chart entry by itself is not evidence of absence; insufficient or contradictory\nevidence yields UNKNOWN. Preserve active, resolved and suspected clinical states separately from\nevidence verification.\n",
      "source_id": "SRC-PROTOCOL-PX104-V1",
