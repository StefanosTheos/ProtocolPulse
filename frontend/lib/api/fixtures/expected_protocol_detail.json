    {
      "criterion_id": "PX-INC-03",
      "type": "INCLUSION",
      "clinical_subject": "egfr",
      "operator": "LAB_GTE",
      "threshold": 60,
      "unit": "mL/min/1.73m²",
      "window": {
        "anchor": "SCREENING_DATE",
        "start_offset_days": -30,
        "end_offset_days": 0,
        "start_inclusive": true,
        "end_inclusive": true,
        "time_zone": "Europe/Athens",
        "anchor_granularity": "LOCAL_DATE"
      },
      "evidence_requirement": "Latest relevant numeric eGFR with valid specimen date, provenance and reviewed unit.",
      "logical_group_id": "PX104-ELIGIBILITY-ALL",
      "protocol_version_id": "PV-PX104-1.0",
      "missing_data_policy": "UNKNOWN_UNLESS_RECONCILED",
      "source_quote": "The latest relevant eGFR must be at least 60 mL/min/1.73m². Its specimen local calendar date must be in\n[2026-10-01, 2026-10-31], including both endpoints. Use specimen date, not issued, recorded or ingestion\ntime. Missing or stale evidence yields UNKNOWN; unsupported units yield UNKNOWN unless a reviewed\nconversion exists. A valid timely value below 60 fails. This threshold is fictional and is not a clinical\nrecommendation.\n",
      "source_id": "SRC-PROTOCOL-PX104-V1",
      "source_page": 2,
