      "operator": "EVENT_ORDER_ONLY",
      "threshold": "SYN-CLASS-R",
      "unit": null,
      "window": {
        "anchor": "PARTICIPATION",
        "start_offset_days": null,
        "end_offset_days": null,
        "start_inclusive": true,
        "end_inclusive": false,
        "time_zone": "Europe/Athens",
        "anchor_granularity": "INSTANT"
      },
      "evidence_requirement": "Dated restricted-class order/dispense with no confirmed use, requiring human reconciliation.",
      "logical_group_id": "PX104-MONITORING-INDEPENDENT",
      "protocol_version_id": "PV-PX104-1.0",
      "missing_data_policy": "UNKNOWN_UNLESS_RECONCILED",
      "source_quote": "During human-recorded participation, a new order or dispense of SYN-CLASS-R without confirmed use\nrequires medication reconciliation. Open a POTENTIAL_SAFETY_REVIEW case; actual exposure remains\nunknown. Retrieve administration and reported-use evidence where available. An order or dispense is not\nproof of ingestion and must not be reported as a confirmed-use conflict. A clinician supplies or reviews any\nreconciliation evidence.\n",
      "source_id": "SRC-PROTOCOL-PX104-V1",
